HTTP_ADDR=127.0.0.1:8080
GRPC_ADDR=127.0.0.1:9090
DATABASE_URL=postgres://engagepulse:engagepulse@localhost:5432/engagepulse?sslmode=disable
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=player.events
KAFKA_DLQ_TOPIC=player.events.dlq
LOG_LEVEL=info

# Rule patch command. mock is default and the CI path.
# PROPOSER=mock
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Shadow scorer. mock is default and the CI path.
# SHADOW_SCORER=mock
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional. Default off. When true, event ids that start with poison- fail after
# mark, retry 3 times, then land on player.events.dlq with no credit.
# Do not set this on the public Railway API.
# FAIL_INJECT=true

# Seed tenants (local demo only). HMAC key id defaults to v1.
# acme-casino: api_key=ak_acme_dev_001 hmac=hmac_acme_dev_secret
# nova-sports: api_key=ak_nova_dev_001 hmac=hmac_nova_dev_secret
